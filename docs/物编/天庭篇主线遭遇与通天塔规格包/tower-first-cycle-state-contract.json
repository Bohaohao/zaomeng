      },
      {
        "spec_id": "TT_SPEC_TOWER_STATE_NEXT_CYCLE_HANDOFF",
        "kind": "external_handoff_terminal",
        "cycle_terminal": true,
        "runtime_key": null,
        "purpose": "第五节拍休整后选择继续时的边界交接；本合同不创建第六节拍或任何后续层。"
      }
    ],
    "terminal_outcome_exclusivity": [
      "同一抽象节拍只能先由权威确定为完成、失败或退出之一；重复请求返回既有权威结果，不能产生第二个结果。",
      "第五节拍休整窗口只能先关闭为结算、退出或下一循环交接之一；三者不能并存。",
      "ENTRY_DENIED、SETTLED、FAILED、EXITED、NEXT_CYCLE_HANDOFF 均为本首轮子循环的终态，不能直接返回活动节拍。"
    ]
  },
