  "cross_chapter_material_and_progression_rules": [
    "所有基础法宝的取得均与是否装备分离；玩家可以不取得、不装备或继续使用前序法宝而完成常规主线。",
    "花果山既有 economy-v2 掉落事实只可被引用，不能被本合同改写、扩展或反推为升级配方。",
    "地府的基础可选取得机会只落在接引院与判官殿；鬼城、无常巷、鬼门关只承担叙事或机制预习，白骨秘境与转轮殿不产生基础材料、阶段、资格或配方。",
    "地府阎罗殿只能确认两件法宝的终局语义成长；任何未来实现都必须消费独立权威完成证明，不能读取、写入或替代 DF_PROGRESS_YANLUO_HALL_CLEARED。",
    "天庭七类残片只以七个对应单人试炼为设计级来源点；天律校印保障单人基础路径，四圣铸核只对应四象覆环的可选展示／叙事印证。",
    "所有材料来源点都要求未来权威会话、资格、重放、断线和清理事实；本合同不得创建这些事实，也不得把客户端、队长、旁观或旧生命周期视为合法来源。",
    "实际材料键、数量、配方、消耗、掉率、保底、资格、背包、收据、迁移、属性和Y3对象必须继续等待独立经济、P0跨职业标定与运行时合同。"
  ],
  "acceptance_matrix": [
    {
      "acceptance_id": "ART-3C-001",
      "rule": "范围恰好包含花果山两件、地府两件与天庭一件法宝；候选龙王二阶、牛魔号角、宠物与额外法宝不得被偷渡为已设计资产。"
    },
    {
      "acceptance_id": "ART-3C-002",
      "rule": "每件法宝拥有展示身份或既有说明身份、阶段定位、非数值玩法卡、推荐携带阶段、取得路线、相对难度与至少两个材料来源蓝图。"
    },
    {
      "acceptance_id": "ART-3C-003",
      "rule": "花果山保持定潮玄印的旧潮首通和熔脉劫核的牛魔稀有事实；本合同不改写 economy-v2 的概率、保底、转换或收据。"
    },
    {
      "acceptance_id": "ART-3C-004",
      "rule": "地府引灯与业镜均为常规主线的可选非随机机会；白骨秘境和转轮殿不得成为基础取得、材料、阶段、资格、配方或主线来源。"
    },
    {
      "acceptance_id": "ART-3C-005",
      "rule": "天庭七类残片分别映射七个单人本，天律校印映射凌霄外庭，四圣铸核只对应四象覆环的可选噩梦展示／叙事印证；团队噩梦不能锁死基础毕业或提供战斗强度。"
    },
    {
      "acceptance_id": "ART-3C-006",
      "rule": "一律保持一个活动法宝槽、挑战内不可换装、前序法宝不被自动吞并、主线/入章不要求具体法宝。"
    },
    {
      "acceptance_id": "ART-3C-007",
      "rule": "真实战斗值、技能秒数、资产键、新材料键、数量、配方、消耗、掉率、保底、资格、收据与Y3对象均保持 null/deferred；用户指定的十枚同星称号规则仅是收藏计数事实。"
